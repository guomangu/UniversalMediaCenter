# ==============================================================================
# 🌍 CONFIGURATION GLOBALE — The Universal Media Stack
# ==============================================================================

# ==========================================
# 📱 FRONTEND (EXPO / REACT NATIVE)
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:3000
PORT=8081

# ==========================================
# ⚙️ BACKEND (HONO API & PIPELINE)
# ==========================================
API_PORT=3000
NODE_ENV=development
AUTH_SECRET=super_secret_session_key_ums
AUTO_SEED_KYOO_PRESET=true

# ==========================================
# 🗄️ BASE DE DONNÉES (POSTGRESQL + POSTGIS)
# ==========================================
POSTGRES_USER=ums
POSTGRES_PASSWORD=ums_secret
POSTGRES_DB=ums_db
DB_PORT=5432
DATABASE_URL=postgresql://ums:ums_secret@localhost:5432/ums_db

# ==========================================
# 📂 DOSSIERS MÉDIAS ET GATEWAY
# ==========================================
GATEWAY_PORT=8080
# Zéro déplacement physique : indexation et tagging in-place sans altérer l'arborescence.
# Supporte un ou plusieurs dossiers séparés par des virgules (ex: /media/chaos,/mnt/nas/films)
MEDIA_CHAOS_ROOT=/home/tele/Vidéos/drive
