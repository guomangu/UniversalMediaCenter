:80 {
    # 1. Routage API Hono (RPC, Auth, Streaming HLS, Proxy IPTV, Cast)
    handle /api/* {
        reverse_proxy backend:3000 {
            @accel header X-Accel-Redirect *
            handle_response @accel {
                root * /media
                rewrite * {rp.header.X-Accel-Redirect}
                method * GET
                file_server
            }
        }
    }

    # 2. Liens d'invitation personnalisés (Open Graph direct pour WhatsApp/Instagram + Connexion 1 clic)
    handle /invite/* {
        reverse_proxy backend:3000
    }

    # 3. Service direct des Artworks et médias locaux
    handle_path /artworks/* {
        root * /media
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # 4. Interface Web Universelle Expo
    handle /* {
        reverse_proxy host.containers.internal:8081 {
            header_up Host {upstream_hostport}
        }
    }
}
