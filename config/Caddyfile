:80 {
    # 1. Routage API Hono (RPC, Auth, Streaming HLS, Proxy IPTV, Cast)
    handle /api/* {
        reverse_proxy backend:3000 {
            @accel header X-Accel-Redirect *
            handle_response @accel {
                root * /media
                rewrite * {rp.header.X-Accel-Redirect}
                method * GET
                file_server
            }
        }
    }

    # 2. Liens d'invitation personnalisés (Open Graph direct pour WhatsApp/Instagram + Connexion 1 clic)
    handle /invite/* {
        reverse_proxy backend:3000
    }

    # 3. Service direct des artworks.
    # Restreint aux images : sans ce filtre, /artworks/<chemin> pouvait servir
    # n'importe quel fichier présent sous /media (vidéos, NFO, etc.) sans auth.
    handle_path /artworks/* {
        @image path *.jpg *.jpeg *.png *.webp *.avif *.gif
        handle @image {
            root * /media
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        respond 404
    }

    # 4. Interface Web Universelle Expo
    handle /* {
        reverse_proxy host.containers.internal:8081 {
            header_up Host {upstream_hostport}
        }
    }
}
